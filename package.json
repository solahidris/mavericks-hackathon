{
  "name": "mavericks-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,gateway \"next dev\" \"wrangler dev --port 8787\"",
    "build": "next build",
    "start": "wrangler dev --port 8787",
    "lint": "eslint",
    "dev:web": "next dev",
    "dev:worker": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply relay-marketplace --local",
    "wallets:setup": "tsx scripts/setup-wallets.ts",
    "seed": "tsx scripts/seed.ts",
    "setup": "npm run wallets:setup && npm run db:migrate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/logic.test.ts",
    "test:e2e": "tsx --test tests/gateway.test.ts",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "check:worker": "wrangler deploy --dry-run",
    "fund:devnet": "tsx scripts/fund-devnet.ts",
    "test:devnet": "tsx scripts/devnet-e2e.ts",
    "format": "prettier --write app lib worker scripts tests README.md *.jsonc",
    "refund:pending": "tsx scripts/refund-pending.ts",
    "test:signer": "tsx scripts/test-signer.ts",
    "dev:test-wallet": "NEXT_PUBLIC_TEST_WALLET=1 next dev"
  },
  "dependencies": {
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "@x402/core": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
